# dsh-wecom-bot 配置示例(复制为 .env 后按需修改)
# 插件自动读取 WECOM_BOT_* 环境变量;plugin config(cordis.patch.yml)优先级更高。

# ===== 通用 =====
# 接收通道:longconn(默认) / callback / both
WECOM_BOT_MODE=longconn

# ===== 长连接模式(智能机器人) =====
# 企业微信管理后台 → 智能机器人 → 获取 botId / botSecret
WECOM_BOT_BOT_ID=your-bot-id
WECOM_BOT_BOT_SECRET=your-bot-secret
# WECOM_BOT_WS_URL=wss://openws.work.weixin.qq.com
# WECOM_BOT_SCENE=
# WECOM_BOT_HEARTBEAT_INTERVAL_MS=30000
# WECOM_BOT_RECONNECT_BASE_DELAY_MS=1000
# WECOM_BOT_MAX_RECONNECT_ATTEMPTS=10
# WECOM_BOT_MAX_AUTH_FAILURE_ATTEMPTS=5
# WECOM_BOT_REQUEST_TIMEOUT_MS=10000
# WECOM_BOT_THINKING_HINT=🤔 正在思考,请稍候…

# ===== 回调模式(自建应用,仅 mode=callback/both 时必填) =====
# WECOM_BOT_CORP_ID=ww123
# WECOM_BOT_APP_SECRET=your-app-secret
# WECOM_BOT_AGENT_ID=1000002
# WECOM_BOT_TOKEN=your-callback-token
# WECOM_BOT_AES_KEY=43-character-encoding-aes-key
# WECOM_BOT_HOST=127.0.0.1
# WECOM_BOT_PORT=8787
# WECOM_BOT_PATH=/wecom/callback
# WECOM_BOT_CHECK_ON_START=false
# WECOM_BOT_API_TIMEOUT_MS=15000

# ===== dsh agent =====
# WECOM_BOT_PROVIDER=deepseek-official
# WECOM_BOT_MODEL=deepseek-v4-flash
# WECOM_BOT_MAX_TOKENS=4096
# WECOM_BOT_WORKSPACE=
# WECOM_BOT_TASK_PREFIX=你是在企业微信里为用户提供帮助的智能助手,请用中文简洁作答。

# ===== 限制与队列 =====
# WECOM_BOT_REPLY_LIMIT_BYTES=2000
# WECOM_BOT_INPUT_LIMIT_CHARS=4000
# WECOM_BOT_MAX_QUEUE_DEPTH=5
# WECOM_BOT_PROMPT_TIMEOUT_MS=600000
# WECOM_BOT_SESSION_ID_PREFIX=wecom
# WECOM_BOT_IGNORE_NON_TEXT=true
# WECOM_BOT_BODY_LIMIT_BYTES=1048576
