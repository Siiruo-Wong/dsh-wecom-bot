# 企业微信配置(也可在 cordis.patch.yml 的 plugin config 里配置,二者取其一)
WECOM_BOT_CORP_ID=wwxxxxxxxxxxxxxxxxxx
WECOM_BOT_APP_SECRET=your-app-secret
WECOM_BOT_AGENT_ID=1000002
WECOM_BOT_TOKEN=your-callback-token
WECOM_BOT_AES_KEY=your-43-char-encoding-aes-key

# 监听与回调路径
WECOM_BOT_HOST=127.0.0.1
WECOM_BOT_PORT=8787
WECOM_BOT_PATH=/wecom/callback

# dsh agent
WECOM_BOT_WORKSPACE=./workspace
WECOM_BOT_PROVIDER=deepseek-official
WECOM_BOT_MODEL=deepseek-v4-flash
WECOM_BOT_TASK_PREFIX=你是在企业微信里为用户提供帮助的智能助手,请用中文简洁作答。
